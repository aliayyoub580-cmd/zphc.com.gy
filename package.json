{
  "name": "zphc-homepage",
  "version": "1.0.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run server\"",
    "build": "npm run build:frontend",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "circle-flags": "^2.8.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
